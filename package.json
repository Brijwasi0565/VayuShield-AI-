{
  "name": "vayushield-ai",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --prod",
    "build": "vite build",
    "preview": "npm run build && tsx server.ts --prod",
    "clean": "node -e \"import('fs').then(fs => ['dist','dev-dist','coverage'].forEach(p => fs.rmSync(p,{recursive:true,force:true})))\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run lint:rules && npm run format:check",
    "lint:rules": "eslint firestore.rules",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" server.ts vite.config.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "test:unit": "npm test",
    "test:coverage": "tsx --test --experimental-test-coverage \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.7",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "three": "^0.187.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "description": "Offline-first PWA for real-time Indian air quality, household health guidance and community hazard mapping.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
