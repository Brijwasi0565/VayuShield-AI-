rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'preferredLanguage', 'points', 'badges', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'preferredLanguage', 'points', 'badges', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.preferredLanguage in ['en', 'hi', 'ta', 'te', 'bn', 'mr', 'gu']
        && data.points is int && data.points >= 0 && data.points <= 1000000
        && data.badges is list && data.badges.size() <= 20 && (data.badges.size() == 0 || data.badges[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHousehold(data) {
      return data.keys().hasAll(['userId', 'name', 'location', 'latitude', 'longitude', 'members', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'location', 'latitude', 'longitude', 'members', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 120
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.members is list && data.members.size() <= 15 && (data.members.size() == 0 || data.members[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSymptom(data) {
      return data.keys().hasAll(['userId', 'type', 'severity', 'aqiAtTime', 'outdoorMinutes', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'severity', 'aqiAtTime', 'outdoorMinutes', 'medicationTaken', 'notes', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.type in ['cough', 'breathlessness', 'eye_irritation', 'headache', 'fatigue', 'wheezing']
        && data.severity is int && data.severity >= 1 && data.severity <= 5
        && data.aqiAtTime is int && data.aqiAtTime >= 0 && data.aqiAtTime <= 1000
        && data.outdoorMinutes is int && data.outdoorMinutes >= 0 && data.outdoorMinutes <= 1440
        && (!('medicationTaken' in data) || (data.medicationTaken is string && data.medicationTaken.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidChallenge(data) {
      return data.keys().hasAll(['userId', 'challengeKey', 'title', 'progress', 'target', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'challengeKey', 'title', 'progress', 'target', 'completed', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.challengeKey is string && data.challengeKey.size() >= 1 && data.challengeKey.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.progress is int && data.progress >= 0 && data.progress <= 1000
        && data.target is int && data.target >= 1 && data.target <= 1000
        && data.completed is bool
        && data.updatedAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['authorId', 'authorAlias', 'type', 'description', 'city', 'latitude', 'longitude', 'upvotes', 'downvotes', 'verified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'authorAlias', 'type', 'description', 'city', 'latitude', 'longitude', 'upvotes', 'downvotes', 'verified', 'createdAt', 'updatedAt'])
        && isValidId(data.authorId)
        && data.authorAlias is string && data.authorAlias.size() >= 1 && data.authorAlias.size() <= 60
        && data.type in ['smoke', 'dust', 'traffic', 'industrial', 'clean_zone']
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 500
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 100000
        && data.downvotes is int && data.downvotes >= 0 && data.downvotes <= 100000
        && data.verified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection validation probe (non-sensitive)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Private User Profile & Subcollections (strictly owner-isolated)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isVerifiedUser() && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isVerifiedUser() && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'points', 'badges', 'updatedAt']);
      allow delete: if isOwner(userId) && isVerifiedUser() && isValidId(userId);

      match /households/{householdId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(householdId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(householdId)
          && isValidHousehold(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(householdId)
          && isValidHousehold(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'latitude', 'longitude', 'members', 'updatedAt']);
        allow delete: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(householdId);
      }

      match /symptoms/{symptomId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(symptomId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(symptomId)
          && isValidSymptom(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(symptomId);
      }

      match /challenges/{challengeId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(challengeId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(challengeId)
          && isValidChallenge(incoming())
          && incoming().userId == userId
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(challengeId)
          && isValidChallenge(incoming())
          && incoming().userId == existing().userId
          && incoming().challengeKey == existing().challengeKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'completed', 'updatedAt']);
        allow delete: if isOwner(userId) && isVerifiedUser() && isValidId(userId) && isValidId(challengeId);
      }
    }

    // Public Environmental Community Reports (no PII stored)
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if resource.data.verified is bool;
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().upvotes == 0
        && incoming().downvotes == 0
        && incoming().verified == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerifiedUser() && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'description', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt']) && incoming().upvotes == existing().upvotes + 1) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['downvotes', 'updatedAt']) && incoming().downvotes == existing().downvotes + 1)
        );
      allow delete: if isSignedIn() && isVerifiedUser() && isValidId(reportId)
        && existing().authorId == request.auth.uid;
    }
  }
}
