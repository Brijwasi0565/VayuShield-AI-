{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account preferences, gamification points, and badges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "hi", "ta", "te", "bn", "mr", "gu"]
        },
        "points": {
          "type": "integer"
        },
        "badges": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "preferredLanguage", "points", "badges", "createdAt", "updatedAt"]
    },
    "HouseholdProfile": {
      "title": "HouseholdProfile",
      "description": "Household location and member health vulnerabilities for personalized air-quality guidance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "members": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "location", "latitude", "longitude", "members", "createdAt", "updatedAt"]
    },
    "SymptomLog": {
      "title": "SymptomLog",
      "description": "Individual respiratory symptom and outdoor exposure record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["cough", "breathlessness", "eye_irritation", "headache", "fatigue", "wheezing"]
        },
        "severity": {
          "type": "integer"
        },
        "aqiAtTime": {
          "type": "integer"
        },
        "outdoorMinutes": {
          "type": "integer"
        },
        "medicationTaken": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "severity", "aqiAtTime", "outdoorMinutes", "createdAt"]
    },
    "ChallengeProgress": {
      "title": "ChallengeProgress",
      "description": "Clean Air Challenge completion tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "challengeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "progress": {
          "type": "integer"
        },
        "target": {
          "type": "integer"
        },
        "completed": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "challengeKey", "title", "progress", "target", "completed", "updatedAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Public environmental hazard or verified clean-air zone report.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": ["smoke", "dust", "traffic", "industrial", "clean_zone"]
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "upvotes": {
          "type": "integer"
        },
        "downvotes": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "authorAlias",
        "type",
        "description",
        "city",
        "latitude",
        "longitude",
        "upvotes",
        "downvotes",
        "verified",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user preferences, points, and earned badges."
    },
    "/users/{userId}/households/{householdId}": {
      "schema": { "$ref": "#/entities/HouseholdProfile" },
      "description": "User household profiles with member vulnerability attributes."
    },
    "/users/{userId}/symptoms/{symptomId}": {
      "schema": { "$ref": "#/entities/SymptomLog" },
      "description": "User respiratory symptom and daily exposure logs."
    },
    "/users/{userId}/challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/ChallengeProgress" },
      "description": "User Clean Air Challenge progress records."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/CommunityReport" },
      "description": "Publicly viewable environmental hazard and clean-zone community reports."
    }
  }
}
