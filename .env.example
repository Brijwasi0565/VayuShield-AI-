# VayuShield AI settings. Copy this file to ".env" and fill in only what you need.
# The ".env" file is ignored by git. NEVER commit it, and never paste real keys into this example file.
#
# The app works with NO keys: air quality, weather, fire alerts, maps, 3D lab and
# household health guidance are free and need no account.

# --- Server -------------------------------------------------------------------
PORT=3000
# Set to 1 (or the number of proxies) when running behind a reverse proxy / hosting platform.
# TRUST_PROXY=1

# --- Optional: Gemini AI (server side only, never sent to the browser) --------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional: extra air quality / fire data (all free tiers) ------------------
# https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=
# https://aqicn.org/data-platform/token/
WAQI_API_KEY=
# https://explore.openaq.org/
OPENAQ_API_KEY=

# --- Optional: Firebase cloud sync (leave blank for offline-only mode) --------
# These end up in the browser by design. Restrict the key to your website in
# Google Cloud Console > APIs & Services > Credentials (see SECURITY.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
